# CampusMind X — Frontend Environment Configuration Template
# For production deployment on Vercel:
# Add VITE_API_URL in Vercel Project Settings -> Environment Variables
# Example: VITE_API_URL=https://your-backend.onrender.com/api
#
# Note: Vite environment variables MUST start with the VITE_ prefix.
# Never place database credentials, JWT secrets, or backend private keys here.

VITE_API_URL=
VITE_AI_ENGINE_URL=
