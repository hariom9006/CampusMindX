PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campusmind_x
JWT_SECRET=supersecret_campusmind_jwt_key_2026
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google Sheets Activity Logging Configuration
# Create a Google Sheet named "CampusMind X User Activity" and share it with your Service Account client email with "Editor" permission
